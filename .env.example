# =====================================================================
# Business CRM Admin Panel — Production Environment Template
# =====================================================================
# Copy this file to backend/.env and frontend/.env.local (or set these in
# your CI/CD / container hosting environment variables).
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# =====================================================================

# ---------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection URL (Prisma connection string)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/business_crm?schema=public"

# Authentication & Session Security (Minimum 32 characters for JWT, 16 for CSRF)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_cryptographically_secure_random_64_character_hex_key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
CSRF_SECRET="replace_with_cryptographically_secure_random_32_character_hex_key"

# CORS & Domain Origin Scoping
# Specify your production frontend URL without trailing slash
APP_ORIGIN="https://crm.example.com"

# Cookie Security (In production: set secure=true, domain=.example.com)
COOKIE_DOMAIN=""
COOKIE_SECURE=true

# First-run accounts, used only by `prisma db seed` (required when NODE_ENV=production).
# Two administrators are created: a Super Admin and an Admin. Use strong, different passwords
# (8+ characters with upper case, lower case and a number) and change them after first sign-in.
INITIAL_COMPANY_NAME="Your Company"
INITIAL_SUPER_ADMIN_EMAIL="superadmin@yourcompany.com"
INITIAL_SUPER_ADMIN_PASSWORD="replace_with_a_strong_password"
INITIAL_ADMIN_EMAIL="admin@yourcompany.com"
INITIAL_ADMIN_PASSWORD="replace_with_a_different_strong_password"

# File attachments (mount UPLOAD_DIR on a persistent volume in production)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api.crm.example.com"
NEXT_PUBLIC_APP_NAME="Business CRM Admin"
