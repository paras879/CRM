{
  "name": "business-crm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Perfex CRM-inspired Business Admin Management Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm --prefix frontend run lint",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "test:frontend": "npm --prefix frontend run test"
  }
}
